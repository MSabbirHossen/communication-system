{
  "$comment": "Source of truth for the design system foundations. Values come from docs/UI_UX_BRIEF.md §4 (color, typography, shape, spacing) and §8 (breakpoints). Dark-theme values the brief does not define are derived to meet WCAG 2.2 AA contrast and are marked derived:true; they need design review. Edit this file, then run `pnpm --filter @cs/design-tokens build`.",
  "font": {
    "family": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans Bengali', 'Noto Naskh Arabic', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": { "regular": "400", "medium": "500", "semibold": "600" }
  },
  "type": {
    "$comment": "Brief §4.3 gives ranges; these are the chosen defaults within them (base 16px).",
    "title": { "size": "1.75rem", "lineHeight": "1.25", "weight": "600" },
    "heading": { "size": "1.25rem", "lineHeight": "1.3", "weight": "600" },
    "body": { "size": "0.9375rem", "lineHeight": "1.5", "weight": "400" },
    "message": { "size": "0.9375rem", "lineHeight": "1.5", "weight": "400" },
    "meta": { "size": "0.8125rem", "lineHeight": "1.4", "weight": "400" },
    "button": { "size": "0.9375rem", "lineHeight": "1.25", "weight": "500" }
  },
  "space": {
    "$comment": "4px base unit (brief §4.4).",
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "bubble": "16px", "pill": "999px" },
  "elevation": {
    "1": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "2": "0 4px 12px rgba(15, 23, 42, 0.10)"
  },
  "size": {
    "touchTarget": "44px",
    "focusRing": "2px",
    "borderWidth": "1px"
  },
  "breakpoint": {
    "$comment": "Brief §8: small mobile <360, mobile 360–767, tablet 768–1023, desktop ≥1024.",
    "sm": "360px",
    "md": "768px",
    "lg": "1024px"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "color": {
    "$comment": "Semantic colors with a value per theme. `derived` marks values not in the brief.",
    "bg": { "light": "#F8FAFC", "dark": "#0B1220" },
    "surface": { "light": "#FFFFFF", "dark": "#111827" },
    "surfaceRaised": { "light": "#FFFFFF", "dark": "#1F2937", "derived": true },
    "text": { "light": "#0F172A", "dark": "#F1F5F9" },
    "textMuted": { "light": "#64748B", "dark": "#94A3B8", "derived": true },
    "border": { "light": "#E2E8F0", "dark": "#334155", "derived": true },
    "primary": { "light": "#2563EB", "dark": "#2563EB" },
    "primaryHover": { "light": "#1D4ED8", "dark": "#1D4ED8" },
    "onPrimary": { "light": "#FFFFFF", "dark": "#FFFFFF", "derived": true },
    "primaryText": { "light": "#1D4ED8", "dark": "#93C5FD", "derived": true },
    "accent": { "light": "#14B8A6", "dark": "#2DD4BF", "derived": true },
    "success": { "light": "#15803D", "dark": "#4ADE80", "derived": true },
    "warning": { "light": "#B45309", "dark": "#FBBF24", "derived": true },
    "danger": { "light": "#B91C1C", "dark": "#F87171", "derived": true },
    "focus": { "light": "#2563EB", "dark": "#93C5FD", "derived": true }
  }
}
