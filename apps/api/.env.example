# Application API — local development. Copy to .env (git-ignored). Placeholders only.
NODE_ENV=development
PORT=3000
# Local MongoDB from infrastructure/docker-compose.yml
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=communication_system
# fatal|error|warn|info|debug|trace|silent (debug/trace are refused in production)
LOG_LEVEL=info
# Comma-separated allowlist; "*" is refused in production
CORS_ORIGINS=http://localhost:5173
# Reserved for Phase 6 (validating Matrix access tokens). Leave unset until then.
# MATRIX_HOMESERVER_URL=http://localhost:8008
