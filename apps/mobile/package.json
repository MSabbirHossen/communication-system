{
  "name": "@cs/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell for Android and iOS around @cs/web (ADR-0001 C2, provisional). Platforms are added in Phase 5.",
  "type": "module",
  "scripts": {
    "build": "node scripts/sync.mjs",
    "build:web": "pnpm --filter @cs/web build && node scripts/sync.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cs/web": "workspace:*"
  }
}
