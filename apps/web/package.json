{
  "name": "@cs/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web client (React + Vite). Phase 1: app shell, theme, responsive layout, offline and error states. Matrix integration starts in Phase 2.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.integration.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cs/design-tokens": "workspace:*",
    "@cs/logger": "workspace:*",
    "@cs/shared-types": "workspace:*",
    "@cs/validation": "workspace:*",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "matrix-js-sdk": "44.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  }
}
